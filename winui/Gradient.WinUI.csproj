<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Content Include="Assets/Cover.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../swiftui/Sources/Gradient/Resources/InterfaceStrings.json"
             Link="InterfaceStrings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../core/target/release/gradient-core.exe" Link="gradient-core.exe"
             CopyToOutputDirectory="PreserveNewest" Condition="Exists('../core/target/release/gradient-core.exe')" />
  </ItemGroup>
</Project>
