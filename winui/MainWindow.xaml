<Window x:Class="Gradient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gradient Launcher">
    <Grid x:Name="Layout" RequestedTheme="Light" Background="#A8DED7" Loaded="Start">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Background="#0C3837" RequestedTheme="Dark">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Padding="18,26,18,12" Spacing="12">
                <TextBlock Text="Gradient" FontSize="25" FontWeight="Bold"/>
                <TextBox x:Name="Search" PlaceholderText="Пошук профілів" TextChanged="SearchChanged"/>
                <Button Content="+  Новий профіль" Click="CreateProfile"/>
                <Button Content="+  Імпортувати .mrpack" Click="Import"/>
            </StackPanel>
            <ListView x:Name="Profiles" Grid.Row="1" Margin="8,0" SelectionChanged="Select">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="22" Height="22" Source="{Binding IconSource}"/>
                            <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Margin="18,12" Spacing="8">
                <Button Content="Акаунти" Click="ManageAccounts"/>
                <Button Content="Увійти в Microsoft" Click="MicrosoftLogin"/>
                <Button Content="Офлайн-акаунт" Click="Login"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Column="1">
            <StackPanel>
                <Grid Height="350">
                    <Image x:Name="Cover" Stretch="UniformToFill" Source="ms-appx:///Assets/Cover.png"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00A8DED7" Offset=".24"/>
                                <GradientStop Color="#DDA8DED7" Offset=".82"/>
                                <GradientStop Color="#A8DED7" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Bottom" Padding="30,0,30,22" Spacing="11">
                        <TextBlock x:Name="Heading" Text="Бібліотека" FontSize="42" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PlayButton" Background="#112C2B" Foreground="White" Content="▶  Грати" Click="Play" IsEnabled="False" Padding="24,8" CornerRadius="18"/>
                            <Button Content="Оновити" Click="Refresh"/>
                            <DropDownButton x:Name="ProfileActions" Content="Дії профілю" IsEnabled="False">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Перейменувати" Click="RenameProfile"/>
                                        <MenuFlyoutItem Text="Змінити іконку" Click="ChangeProfileIcon"/>
                                        <MenuFlyoutItem Text="Дублювати" Click="DuplicateProfile"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Видалити профіль" Click="RemoveProfile"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Padding="30,0,30,32" Spacing="14">
                    <Border BorderBrush="#5B9390" BorderThickness="0,1,0,1" Padding="0,12">
                        <TextBlock x:Name="Metadata" Text="Виберіть профіль або імпортуйте модпак." TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Pivot x:Name="Details" SelectionChanged="DetailChanged">
                        <PivotItem x:Name="LogTab" Header="Живий лог">
                            <TextBlock x:Name="GameLog" Text="Виберіть профіль." FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </PivotItem>
                        <PivotItem Header="Завантаження">
                            <StackPanel x:Name="Jobs" Spacing="8"/>
                        </PivotItem>
                        <PivotItem x:Name="ContentTab" Header="Контент">
                            <StackPanel Spacing="8">
                                <Button x:Name="AddModButton" Content="+  Додати .jar" Click="AddMod" IsEnabled="False"/>
                                <StackPanel x:Name="ContentRows" Spacing="8"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem x:Name="WorldsTab" Header="Світи">
                            <StackPanel x:Name="WorldRows" Spacing="8"/>
                        </PivotItem>
                    </Pivot>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
