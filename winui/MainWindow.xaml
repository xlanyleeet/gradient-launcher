<Window x:Class="Gradient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gradient Launcher">
    <Grid x:Name="Layout" RequestedTheme="Light" Background="#A8DED7" Loaded="Start">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Background="#0C3837" RequestedTheme="Dark">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Padding="18,26,18,12" Spacing="12">
                <TextBlock Text="Gradient" FontSize="25" FontWeight="Bold"/>
                <TextBox x:Name="Search" PlaceholderText="Пошук профілів" TextChanged="SearchChanged"/>
                <Button Content="Каталог Modrinth" Click="OpenDiscover"/>
                <Button Content="+  Новий профіль" Click="CreateProfile"/>
                <Button Content="+  Імпортувати .mrpack" Click="Import"/>
                <Button Content="Імпорт з лаунчера" Click="ImportLauncher"/>
            </StackPanel>
            <ListView x:Name="Profiles" Grid.Row="1" Margin="8,0" SelectionChanged="Select">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Width="22" Height="22" Source="{Binding IconSource}"/>
                            <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Margin="18,12" Spacing="8">
                <Button Content="Акаунти" Click="ManageAccounts"/>
                <Button Content="Увійти в Microsoft" Click="MicrosoftLogin"/>
                <Button Content="Офлайн-акаунт" Click="Login"/>
                <Button Content="Налаштування" Click="OpenSettings"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="LibraryPage" Grid.Column="1">
            <StackPanel>
                <Grid Height="350">
                    <Image x:Name="Cover" Stretch="UniformToFill" Source="ms-appx:///Assets/Cover.png"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00A8DED7" Offset=".24"/>
                                <GradientStop Color="#DDA8DED7" Offset=".82"/>
                                <GradientStop Color="#A8DED7" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Bottom" Padding="30,0,30,22" Spacing="11">
                        <TextBlock x:Name="Heading" Text="Бібліотека" FontSize="42" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PlayButton" Background="#112C2B" Foreground="White" Content="▶  Грати" Click="Play" IsEnabled="False" Padding="24,8" CornerRadius="18"/>
                            <Button Content="Оновити" Click="Refresh"/>
                            <DropDownButton x:Name="ProfileActions" Content="Дії профілю" IsEnabled="False">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Перейменувати" Click="RenameProfile"/>
                                        <MenuFlyoutItem Text="Змінити іконку" Click="ChangeProfileIcon"/>
                                        <MenuFlyoutItem Text="Java та пам’ять" Click="EditProfileLaunchSettings"/>
                                        <MenuFlyoutItem Text="Групи профілю" Click="ProfileGroups"/>
                                        <MenuFlyoutItem Text="Дублювати" Click="DuplicateProfile"/>
                                        <MenuFlyoutItem Text="Експортувати .mrpack" Click="ExportProfile"/>
                                        <MenuFlyoutItem Text="Відкрити папку профілю" Click="OpenProfileFolder"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Видалити профіль" Click="RemoveProfile"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Padding="30,0,30,32" Spacing="14">
                    <Border BorderBrush="#5B9390" BorderThickness="0,1,0,1" Padding="0,12">
                        <TextBlock x:Name="Metadata" Text="Виберіть профіль або імпортуйте модпак." TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Pivot x:Name="Details" SelectionChanged="DetailChanged">
                        <PivotItem x:Name="LogTab" Header="Логи">
                            <StackPanel Spacing="12">
                                <ComboBox x:Name="LogPicker" Header="Джерело логу" DisplayMemberPath="Label"
                                          SelectionChanged="LogChanged" IsEnabled="False" MaxWidth="380"/>
                                <TextBlock x:Name="GameLog" Text="Виберіть профіль." FontFamily="Consolas"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem Header="Завантаження">
                            <StackPanel x:Name="Jobs" Spacing="8"/>
                        </PivotItem>
                        <PivotItem x:Name="ContentTab" Header="Контент">
                            <StackPanel Spacing="8">
                                <Button x:Name="AddModButton" Content="+  Додати .jar" Click="AddMod" IsEnabled="False"/>
                                <StackPanel x:Name="ContentRows" Spacing="8"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem x:Name="WorldsTab" Header="Світи">
                            <StackPanel x:Name="WorldRows" Spacing="8"/>
                        </PivotItem>
                        <PivotItem x:Name="ScreenshotsTab" Header="Скриншоти">
                            <StackPanel Spacing="12">
                                <Button x:Name="ExportShotsButton" Content="Експортувати всі у ZIP"
                                        IsEnabled="False" Click="ExportScreenshots"/>
                                <ComboBox x:Name="ScreenshotPicker" Header="Скриншот" DisplayMemberPath="filename"
                                          IsEnabled="False" SelectionChanged="ScreenshotChanged"/>
                                <TextBlock x:Name="ScreenshotStatus" Text="Виберіть профіль." TextWrapping="Wrap"/>
                                <Image x:Name="ScreenshotPreview" MaxHeight="440" Stretch="Uniform"
                                       HorizontalAlignment="Left"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem x:Name="FilesTab" Header="Файли">
                            <StackPanel Spacing="8">
                                <Button x:Name="ParentDirectoryButton" Content="На рівень вище" Click="ParentDirectory" IsEnabled="False"/>
                                <TextBlock x:Name="DirectoryLabel" Text="Файли профілю" TextWrapping="Wrap"/>
                                <ListView x:Name="FileList" MaxHeight="380" DisplayMemberPath="Label"
                                          IsItemClickEnabled="True" SelectionMode="None" ItemClick="OpenFileEntry"/>
                            </StackPanel>
                        </PivotItem>
                        <PivotItem x:Name="ServersTab" Header="Сервери">
                            <StackPanel Spacing="8">
                                <Button x:Name="AddServerButton" Content="Додати сервер" Click="AddServer" IsEnabled="False"/>
                                <StackPanel x:Name="ServerRows" Spacing="10"/>
                            </StackPanel>
                        </PivotItem>
                    </Pivot>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Padding="30" Spacing="16" HorizontalAlignment="Left" MaxWidth="680">
                <Button Content="До бібліотеки" Click="CloseSettings"/>
                <TextBlock Text="Налаштування запуску" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBox x:Name="MemorySetting" Header="Максимум пам’яті (МіБ)" InputScope="Number"/>
                <ToggleSwitch x:Name="FullscreenSetting" Header="На весь екран"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox x:Name="WidthSetting" Header="Ширина (пкс)" InputScope="Number" MinWidth="140"/>
                    <TextBox x:Name="HeightSetting" Header="Висота (пкс)" InputScope="Number" MinWidth="140"/>
                </StackPanel>
                <TextBox x:Name="ArgumentsSetting" Header="Аргументи JVM · один на рядок" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="Wrap" MinHeight="96"/>
                <Button x:Name="SaveSettingsButton" Content="Зберегти" Click="SaveSettings"/>
                <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="DiscoverPage" Grid.Column="1" Visibility="Collapsed" Padding="24"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <Button Content="До бібліотеки" Click="CloseDiscover"/>
                <TextBlock Text="Каталог Modrinth" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="8">
                <ComboBox x:Name="DiscoverKind" Header="Тип контенту" SelectedIndex="0">
                    <ComboBoxItem Content="Модпаки" Tag="modpack"/>
                    <ComboBoxItem Content="Моди для вибраного профілю" Tag="mod"/>
                </ComboBox>
                <AutoSuggestBox x:Name="DiscoverQuery" PlaceholderText="Знайти на Modrinth" QueryIcon="Find"
                                QuerySubmitted="DiscoverSearch"/>
            </StackPanel>
            <ListView x:Name="DiscoverResults" Grid.Row="2" IsItemClickEnabled="True"
                      SelectionMode="None" ItemClick="SelectDiscoverResult">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6" Spacing="3">
                            <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding author}"/>
                            <TextBlock Text="{Binding description}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="3" Spacing="8">
                <Button x:Name="DiscoverMore" Content="Наступна сторінка" IsEnabled="False" Click="DiscoverNext"/>
                <TextBlock x:Name="DiscoverStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
