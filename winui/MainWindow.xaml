<Window x:Class="Gradient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Gradient"
        xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals" Title="Gradient Launcher">
    <Grid x:Name="Layout" Loaded="Start">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CaptionLeftSpace" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="2*" MaxWidth="760"/>
                <ColumnDefinition Width="*" MinWidth="44"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="CaptionRightSpace" Width="0"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PaneButton" Grid.Column="1" Width="40" Height="36" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="{local:Translate Key='Бічне меню'}"
                    ToolTipService.ToolTip="{local:Translate Key='Бічне меню'}" Click="ToggleNavigationPane">
                <FontIcon Glyph="&#xE700;" FontSize="15"/>
            </Button>
            <Button x:Name="BackButton" Grid.Column="2" Width="40" Height="36" Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed" AutomationProperties.Name="{local:Translate Key='Назад'}"
                    ToolTipService.ToolTip="{local:Translate Key='Назад'}" Click="BackToLibrary">
                <AnimatedIcon x:Name="BackArrow" AnimatedIcon.State="Normal" Width="16" Height="16">
                    <AnimatedIcon.Source><animated:AnimatedBackVisualSource/></AnimatedIcon.Source>
                    <AnimatedIcon.FallbackIconSource><SymbolIconSource Symbol="Back"/></AnimatedIcon.FallbackIconSource>
                </AnimatedIcon>
            </Button>
            <Image Grid.Column="3" Width="20" Height="20" Source="ms-appx:///Assets/Launcher.png"
                   AutomationProperties.AccessibilityView="Raw"/>
            <AutoSuggestBox x:Name="Search" Grid.ColumnSpan="8" MinWidth="0" Width="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" QueryIcon="Find"
                            PlaceholderText="{local:Translate Key='Пошук профілів'}" AutomationProperties.Name="{local:Translate Key='Пошук профілів'}"
                            TextChanged="SearchChanged" QuerySubmitted="SubmitProfileSearch"/>
                <Button x:Name="AccountsButton" Grid.Column="6" Width="40" Height="40" Padding="4,0"
                        Margin="0,0,8,0" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" CornerRadius="20"
                        Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="{local:Translate Key='Акаунти Minecraft'}" ToolTipService.ToolTip="{local:Translate Key='Акаунти Minecraft'}">
                    <Image x:Name="AccountAvatar" Width="28" Height="28" Source="ms-appx:///Assets/PlayerHead.png"
                           AutomationProperties.AccessibilityView="Raw" ImageFailed="AccountAvatarFailed"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{local:Translate Key='Керувати акаунтами'}" Click="ManageAccounts">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Contact"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="{local:Translate Key='Увійти в Microsoft'}" Click="MicrosoftLogin">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Permissions"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{local:Translate Key='Додати офлайн-акаунт'}" Click="Login">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="AddFriend"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{local:Translate Key='Скін Minecraft'}" Click="ManageSkin">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="LeftCompact" IsPaneOpen="False" CompactPaneLength="56" OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        AlwaysShowHeader="False" IsSettingsVisible="False"
                        ItemInvoked="Navigate">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" x:Name="OverlayPaneBrush"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" x:Name="ExpandedPaneBrush"/>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryNavigation" Content="{local:Translate Key='Бібліотека'}" Icon="Library"
                                    ToolTipService.ToolTip="{local:Translate Key='Бібліотека'}"/>
                <NavigationViewItem x:Name="DiscoverNavigation" Content="{local:Translate Key='Каталог'}"
                                    ToolTipService.ToolTip="{local:Translate Key='Каталог'}">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20">
                            <ImageIcon.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/Modrinth.svg"/>
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem x:Name="MoreProfilesNavigation" Icon="More" Visibility="Collapsed" SelectsOnInvoked="False"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem x:Name="AddProfileNavigation" Icon="Add" SelectsOnInvoked="False"
                                    Content="{local:Translate Key='Додати профіль'}"
                                    ToolTipService.ToolTip="{local:Translate Key='Додати профіль'}">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                            <MenuFlyoutItem Text="{local:Translate Key='Новий профіль'}" Click="CreateProfile"/>
                            <MenuFlyoutItem Text="{local:Translate Key='Імпортувати .mrpack'}" Click="Import"/>
                            <MenuFlyoutItem Text="{local:Translate Key='Імпорт з лаунчера'}" Click="ImportLauncher"/>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SkinNavigation" Content="{local:Translate Key='Скін Minecraft'}"
                                    Icon="Contact" Visibility="Collapsed" SelectsOnInvoked="False"/>
                <NavigationViewItem x:Name="WhatsNewNavigation" Content="{local:Translate Key='Що нового'}" Icon="Message"
                                    ToolTipService.ToolTip="{local:Translate Key='Що нового'}" SelectsOnInvoked="False"/>
                <NavigationViewItem x:Name="SettingsNavigation" Content="{local:Translate Key='Налаштування'}" Icon="Setting"
                                    ToolTipService.ToolTip="{local:Translate Key='Налаштування'}"/>
            </NavigationView.FooterMenuItems>
            <Grid x:Name="LibrarySurface">
                <ScrollViewer x:Name="LibraryHome" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel Padding="24" Spacing="16">
                        <Expander x:Name="QuickSection" Header="{local:Translate Key='Швидкий перехід'}"
                                  IsExpanded="True" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <GridView x:Name="QuickPlayCards" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OpenQuickPlay">
                                <GridView.ItemTemplate><DataTemplate>
                                    <StackPanel Width="214" Padding="12" Spacing="5" CornerRadius="12"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                </DataTemplate></GridView.ItemTemplate>
                            </GridView>
                        </Expander>
                        <TextBlock Text="{local:Translate Key='Бібліотека'}" Style="{StaticResource TitleTextBlockStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="HomeSearch" QueryIcon="Find" TextChanged="HomeSearchChanged"
                                            PlaceholderText="{local:Translate Key='Пошук профілів'}"/>
                            <Button Grid.Column="1" Content="{local:Translate Key='Новий профіль'}" Click="CreateProfile"/>
                        </Grid>
                        <ProgressBar x:Name="StartupProgress" IsIndeterminate="True"
                                     AutomationProperties.Name="{local:Translate Key='Завантажуємо бібліотеку…'}"/>
                        <GridView x:Name="LibraryCards" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OpenLibraryProfile">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="144" Padding="10" Spacing="7" CornerRadius="12"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid Height="108">
                                            <SymbolIcon Symbol="Library"/>
                                            <Image Source="{Binding IconSource}" Stretch="Uniform"/>
                                        </Grid>
                                        <TextBlock Text="{Binding name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GameLabel}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <ListView x:Name="CompactLibrary" Visibility="Collapsed" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="OpenLibraryProfile">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="6">
                                        <Image Width="32" Height="32" Source="{Binding IconSource}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding GameLabel}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="LibraryStatus" TextWrapping="Wrap"/>
                        <Button x:Name="CopyLibraryDetails" Visibility="Collapsed" Content="{local:Translate Key='Копіювати'}" Click="CopyStatusDetails"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="LibraryPage" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Height="350">
                            <Image x:Name="Cover" Stretch="UniformToFill" Source="ms-appx:///Assets/Cover.png"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop x:Name="CoverClear" Offset=".38"/>
                                        <GradientStop x:Name="CoverFade" Offset=".76"/>
                                        <GradientStop x:Name="CoverSolid" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Padding="30,0,30,22" Spacing="11">
                                <TextBlock x:Name="Heading" Text="{local:Translate Key='Бібліотека'}" FontSize="42" FontWeight="Bold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PlayButton" Background="#112C2B" Foreground="White" Content="{local:Translate Key='▶  Грати'}" Click="Play" IsEnabled="False" Padding="24,8" CornerRadius="18"/>
                                    <Button Content="{local:Translate Key='Оновити'}" Click="Refresh"/>
                                    <DropDownButton x:Name="ProfileActions" Content="{local:Translate Key='Дії профілю'}" IsEnabled="False">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{local:Translate Key='Перейменувати'}" Click="RenameProfile"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Змінити іконку'}" Click="ChangeProfileIcon"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Java та пам’ять'}" Click="EditProfileLaunchSettings"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Групи профілю'}" Click="ProfileGroups"/>
                                                <MenuFlyoutItem x:Name="UpdateModpackItem" Text="{local:Translate Key='Оновити модпак'}" Click="UpdateModpack" Visibility="Collapsed"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Дублювати'}" Click="DuplicateProfile"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Експортувати .mrpack'}" Click="ExportProfile"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Відкрити папку профілю'}" Click="OpenProfileFolder"/>
                                        <MenuFlyoutItem Text="{local:Translate Key='Створити ярлик'}" Click="CreateProfileShortcut"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Видалити профіль'}" Click="RemoveProfile"/>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Padding="30,0,30,32" Spacing="14">
                            <Border BorderBrush="#5B9390" BorderThickness="0,1,0,1" Padding="0,12">
                                <TextBlock x:Name="Metadata" Text="{local:Translate Key='Виберіть профіль або імпортуйте модпак.'}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="CopyProfileDetails" Visibility="Collapsed" Content="{local:Translate Key='Копіювати'}" Click="CopyStatusDetails"/>
                            <Pivot x:Name="Details" SelectionChanged="DetailChanged">
                                <PivotItem x:Name="ContentTab" Header="{local:Translate Key='Контент'}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <DropDownButton x:Name="AddModButton" Content="{local:Translate Key='Додати файл'}" IsEnabled="False">
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Мод (.jar)'}" Tag="mod" Click="AddContentFile"/>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Пакет ресурсів (.zip)'}" Tag="resourcepack" Click="AddContentFile"/>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Шейдер (.zip)'}" Tag="shaderpack" Click="AddContentFile"/>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Пакет даних (.zip)'}" Tag="datapack" Click="AddContentFile"/>
                                                    </MenuFlyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                            <Button x:Name="UpdateAllContentButton" Content="{local:Translate Key='Оновити все'}" Click="UpdateAllContent" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ContentSearch" PlaceholderText="{local:Translate Key='Пошук контенту'}" TextChanged="ChangeContentSearch"/>
                                            <ComboBox x:Name="ContentKindFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="ChangeContentKindFilter"
                                                      AutomationProperties.Name="{local:Translate Key='Фільтр контенту'}">
                                                <ComboBoxItem Content="{local:Translate Key='Усі'}" Tag="all"/>
                                                <ComboBoxItem Content="{local:Translate Key='Моди'}" Tag="mod"/>
                                                <ComboBoxItem Content="{local:Translate Key='Шейдери'}" Tag="shaderpack"/>
                                                <ComboBoxItem Content="{local:Translate Key='Пакети ресурсів'}" Tag="resourcepack"/>
                                                <ComboBoxItem Content="{local:Translate Key='Пакети даних'}" Tag="datapack"/>
                                                <ComboBoxItem Content="{local:Translate Key='Є оновлення'}" Tag="updates"/>
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox x:Name="ShowPackContent" Content="{local:Translate Key='Показувати стандартний контент'}"
                                                  Checked="ChangeContentFilter" Unchecked="ChangeContentFilter"/>
                                        <StackPanel x:Name="ContentRows" Spacing="8"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="LogTab" Header="{local:Translate Key='Логи'}">
                                    <StackPanel Spacing="12">
                                        <ComboBox x:Name="LogPicker" Header="{local:Translate Key='Джерело логу'}" DisplayMemberPath="Label"
                                                  SelectionChanged="LogChanged" IsEnabled="False" MaxWidth="380"/>
                                        <TextBlock x:Name="GameLog" Text="{local:Translate Key='Виберіть профіль.'}" FontFamily="Consolas"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="DownloadsTab" Header="{local:Translate Key='Завантаження'}">
                                    <StackPanel x:Name="Jobs" Spacing="8"/>
                                </PivotItem>
                                <PivotItem x:Name="WorldsTab" Header="{local:Translate Key='Світи'}">
                                    <StackPanel x:Name="WorldRows" Spacing="8"/>
                                </PivotItem>
                                <PivotItem x:Name="ScreenshotsTab" Header="{local:Translate Key='Скриншоти'}">
                                    <StackPanel Spacing="12">
                                        <Button x:Name="ExportShotsButton" Content="{local:Translate Key='Експортувати всі у ZIP'}"
                                                IsEnabled="False" Click="ExportScreenshots"/>
                                        <ComboBox x:Name="ScreenshotPicker" Header="{local:Translate Key='Скриншот'}" DisplayMemberPath="filename"
                                                  IsEnabled="False" SelectionChanged="ScreenshotChanged"/>
                                        <TextBlock x:Name="ScreenshotStatus" Text="{local:Translate Key='Виберіть профіль.'}" TextWrapping="Wrap"/>
                                        <Image x:Name="ScreenshotPreview" MaxHeight="440" Stretch="Uniform"
                                               HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="FilesTab" Header="{local:Translate Key='Файли'}">
                                    <StackPanel Spacing="8">
                                        <Button x:Name="ParentDirectoryButton" Content="{local:Translate Key='На рівень вище'}" Click="ParentDirectory" IsEnabled="False"/>
                                        <TextBlock x:Name="DirectoryLabel" Text="{local:Translate Key='Файли профілю'}" TextWrapping="Wrap"/>
                                        <ListView x:Name="FileList" MaxHeight="380" DisplayMemberPath="Label"
                                                  IsItemClickEnabled="True" SelectionMode="None" ItemClick="OpenFileEntry"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="ServersTab" Header="{local:Translate Key='Сервери'}">
                                    <StackPanel Spacing="8">
                                        <Button x:Name="AddServerButton" Content="{local:Translate Key='Додати сервер'}" Click="AddServer" IsEnabled="False"/>
                                        <StackPanel x:Name="ServerRows" Spacing="10"/>
                                    </StackPanel>
                                </PivotItem>
                            </Pivot>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid Padding="24,28,24,32">
                        <StackPanel Spacing="14" MaxWidth="760">
                            <StackPanel.Resources>
                                <Style x:Key="SettingsCard" TargetType="Border">
                                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="16,12"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="{local:Translate Key='Налаштування'}" Style="{StaticResource TitleTextBlockStyle}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{local:Translate Key='Вигляд і мова'}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,2"/>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Тема'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ThemeSetting" Grid.Column="1" Width="144" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{local:Translate Key='Тема'}" SelectionChanged="ChangeAppearance">
                                            <ComboBoxItem Content="{local:Translate Key='Системна'}" Tag="system"/>
                                            <ComboBoxItem Content="{local:Translate Key='Світла'}" Tag="light"/>
                                            <ComboBoxItem Content="{local:Translate Key='Темна'}" Tag="dark"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Мова'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="LanguageSetting" Grid.Column="1" Width="144" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{local:Translate Key='Мова'}" SelectionChanged="ChangeAppearance">
                                            <ComboBoxItem Content="Українська" Tag="uk"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Профілів у бічній панелі'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <NumberBox x:Name="SidebarLimitSetting" Grid.Column="1" Width="144" VerticalAlignment="Center"
                                                   AutomationProperties.Name="{local:Translate Key='Профілів у бічній панелі'}"
                                                   Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline" ValueChanged="ChangeSidebarLimit"/>
                                    </Grid>
                                    <TextBlock x:Name="AppearanceStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{local:Translate Key='Налаштування запуску'}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,2"/>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Максимум пам’яті (МіБ)'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBox x:Name="MemorySetting" Grid.Column="1" Width="144" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{local:Translate Key='Максимум пам’яті (МіБ)'}" InputScope="Number"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock x:Name="MemoryHint" Visibility="Collapsed" Opacity="0.75" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="RecommendedMemoryButton" Content="{local:Translate Key='Рекомендовано'}" Click="ApplyRecommendedMemory" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='На весь екран'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <ToggleSwitch x:Name="FullscreenSetting" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{local:Translate Key='На весь екран'}"
                                                      OnContent="" OffContent=""/>
                                    </Grid>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Ширина (пкс)'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBox x:Name="WidthSetting" Grid.Column="1" Width="144" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{local:Translate Key='Ширина (пкс)'}" InputScope="Number"/>
                                    </Grid>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Висота (пкс)'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <TextBox x:Name="HeightSetting" Grid.Column="1" Width="144" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{local:Translate Key='Висота (пкс)'}" InputScope="Number"/>
                                    </Grid>
                                    <Expander Header="{local:Translate Key='Java та JVM'}" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" Margin="0,6,0,0">
                                        <StackPanel Spacing="10">
                                            <Button Content="{local:Translate Key='Інсталяції Java'}" Click="ManageJava"/>
                                            <Button Content="{local:Translate Key='Пресет JVM'}">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Застосувати G1GC'}" Click="UseG1Preset"/>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Застосувати ZGC (Java 21+)'}" Click="UseZgcPreset"/>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Застосувати Shenandoah (сумісна Java)'}" Click="UseShenandoahPreset"/>
                                                        <MenuFlyoutItem Text="{local:Translate Key='Очистити аргументи JVM'}" Click="ResetJvmArguments"/>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <TextBlock x:Name="JavaStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                            <TextBox x:Name="ArgumentsSetting" Header="{local:Translate Key='Аргументи JVM · один на рядок'}"
                                                     AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="96"/>
                                        </StackPanel>
                                    </Expander>
                                    <Button x:Name="SaveSettingsButton" Content="{local:Translate Key='Зберегти'}" Click="SaveSettings"
                                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="SettingsStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="BehaviorSection" Header="{local:Translate Key='Поведінка'}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                            <Expander x:Name="StorageSection" Header="{local:Translate Key='Сховище й діагностика'}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{local:Translate Key='Інтеграції'}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,2"/>
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Discord Rich Presence"/>
                                            <TextBlock Text="{local:Translate Key='Показувати в Discord, коли відкрито лаунчер або запущено профіль Minecraft.'}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DiscordPresenceSetting" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Discord Rich Presence" IsEnabled="False"
                                                      OnContent="" OffContent="" Toggled="ChangeDiscordPresence"/>
                                    </Grid>
                                    <TextBlock x:Name="DiscordStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Посилання Gradient'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" VerticalAlignment="Center"
                                                Content="{local:Translate Key='Увімкнути посилання Gradient'}" Click="RegisterProjectLinks"/>
                                    </Grid>
                                    <TextBlock x:Name="IntegrationStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="12" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{local:Translate Key='Оновлення Gradient'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="CheckUpdateButton" Grid.Column="1" VerticalAlignment="Center"
                                                Content="{local:Translate Key='Перевірити оновлення'}" Click="CheckUpdate"/>
                                    </Grid>
                                    <TextBlock x:Name="UpdateStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                    <HyperlinkButton x:Name="UpdateDownload" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Grid x:Name="ProjectPage" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <ScrollViewer x:Name="ProjectScroll" ViewChanged="ProjectScrollChanged">
                        <StackPanel x:Name="ProjectContent" Padding="24" Spacing="20"/>
                    </ScrollViewer>
                    <Border x:Name="ProjectStickyHeader" Visibility="Collapsed" VerticalAlignment="Top"
                            Margin="24,8,24,0" Padding="12" CornerRadius="10" BorderThickness="1"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Image x:Name="ProjectStickyIcon" Width="44" Height="44"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProjectStickyTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <ContentControl x:Name="ProjectStickyLink" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="ProjectStickySubtitle" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ProjectStickyStatus" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <ContentControl x:Name="ProjectStickyAction" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="DiscoverPage" Visibility="Collapsed" Padding="24"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{local:Translate Key='Каталог'}" Style="{StaticResource TitleTextBlockStyle}"/>
                        <ComboBox x:Name="DiscoverSource" AutomationProperties.Name="{local:Translate Key='Джерело каталогу'}"
                                  SelectedIndex="0" SelectionChanged="DiscoverSourceChanged">
                            <ComboBoxItem Content="Modrinth"/>
                            <ComboBoxItem Content="CurseForge"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Border HorizontalAlignment="Left" Padding="4" CornerRadius="24"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel x:Name="DiscoverCategories" Orientation="Horizontal" Spacing="2"
                                            AutomationProperties.Name="{local:Translate Key='Тип контенту'}">
                                    <StackPanel.Resources>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="12,6"/>
                                            <Setter Property="CornerRadius" Value="18"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <ToggleButton Content="{local:Translate Key='Збірки'}" Tag="modpack" IsChecked="True" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Моди'}" Tag="mod" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Пакети ресурсів'}" Tag="resourcepack" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Пакети даних'}" Tag="datapack" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Шейдери'}" Tag="shader" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Сервери'}" Tag="server" Click="DiscoverCategoryClick"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="DiscoverQuery" PlaceholderText="{local:Translate Key='Знайти на Modrinth'}" QueryIcon="Find"
                                            QuerySubmitted="DiscoverSearch"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{local:Translate Key='Пошук'}" Click="DiscoverSearchClick"/>
                                <Button x:Name="DiscoverOpenLink" Content="{local:Translate Key='Відкрити посилання'}" Click="OpenLinkClick"/>
                            </StackPanel>
                        </Grid>
                        <Expander Header="{local:Translate Key='Фільтри та сортування'}" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="DiscoverSort" Header="{local:Translate Key='Сортувати'}" SelectedIndex="0">
                                    <ComboBoxItem Content="{local:Translate Key='Автоматично'}"/>
                                    <ComboBoxItem x:Name="DiscoverPopularity" Content="{local:Translate Key='За завантаженнями'}" Tag="downloads"/>
                                    <ComboBoxItem Content="{local:Translate Key='Найновіші'}" Tag="newest"/>
                                    <ComboBoxItem Content="{local:Translate Key='Нещодавно оновлені'}" Tag="updated"/>
                                </ComboBox>
                                <StackPanel x:Name="DiscoverPackFilters" Spacing="8">
                                    <TextBox x:Name="DiscoverGameVersion" Header="{local:Translate Key='Версія Minecraft'}" PlaceholderText="{local:Translate Key='Наприклад, 1.21.1'}"/>
                                    <ComboBox x:Name="DiscoverLoader" Header="{local:Translate Key='Завантажувач'}" SelectedIndex="0">
                                        <ComboBoxItem Content="{local:Translate Key='Усі'}"/>
                                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                        <ComboBoxItem Content="Forge" Tag="forge"/>
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                        <ComboBoxItem Content="Quilt" Tag="quilt"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="{local:Translate Key='Застосувати'}" Click="DiscoverSearchClick"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <ListView x:Name="DiscoverResults" Grid.Row="2" IsItemClickEnabled="True"
                              SelectionMode="None" ItemClick="SelectDiscoverResult">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                            <Grid Margin="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Width="44" Height="44" VerticalAlignment="Top">
                                    <Image Source="{Binding IconSource}" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding author}"/>
                                    <TextBlock Text="{Binding description}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="8">
                        <StackPanel x:Name="DiscoverPagination" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="DiscoverBack" MinWidth="36" Visibility="Collapsed" Click="DiscoverPrevious"/>
                            <TextBlock x:Name="DiscoverCurrentPage" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="DiscoverMore" MinWidth="36" Visibility="Collapsed" Click="DiscoverNext"/>
                        </StackPanel>
                        <TextBlock x:Name="DiscoverStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
