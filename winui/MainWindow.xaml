<Window x:Class="Gradient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Gradient" Title="Gradient Launcher">
    <Grid x:Name="Layout" Loaded="Start">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="WindowTitleBar" Title="Gradient Launcher"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="ToggleNavigationPane">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/Launcher.png" ShowAsMonochrome="False"/>
            </TitleBar.IconSource>
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <Grid Margin="14,0,12,0">
                    <AutoSuggestBox x:Name="Search" MaxWidth="760" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" QueryIcon="Find"
                                    PlaceholderText="{local:Translate Key='Пошук профілів'}" AutomationProperties.Name="{local:Translate Key='Пошук профілів'}"
                                    TextChanged="SearchChanged" QuerySubmitted="SubmitProfileSearch"/>
                </Grid>
            </TitleBar.Content>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="LeftCompact" IsPaneOpen="True" CompactPaneLength="56" OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        AlwaysShowHeader="False" IsSettingsVisible="False"
                        ItemInvoked="Navigate" PaneOpening="ShowProfileList" PaneClosing="HideProfileList">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryNavigation" Content="{local:Translate Key='Бібліотека'}" Icon="Library"
                                    ToolTipService.ToolTip="{local:Translate Key='Бібліотека'}"/>
                <NavigationViewItem x:Name="DiscoverNavigation" Content="{local:Translate Key='Каталог Modrinth'}"
                                    ToolTipService.ToolTip="{local:Translate Key='Каталог Modrinth'}">
                    <NavigationViewItem.Icon>
                        <ImageIcon Width="20" Height="20">
                            <ImageIcon.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/Modrinth.svg"/>
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AddProfileNavigation" Icon="Add" SelectsOnInvoked="False"
                                    Content="{local:Translate Key='Додати профіль'}"
                                    ToolTipService.ToolTip="{local:Translate Key='Створити або імпортувати профіль'}">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                            <MenuFlyoutItem Text="{local:Translate Key='Новий профіль'}" Click="CreateProfile"/>
                            <MenuFlyoutItem Text="{local:Translate Key='Імпортувати .mrpack'}" Click="Import"/>
                            <MenuFlyoutItem Text="{local:Translate Key='Імпорт з лаунчера'}" Click="ImportLauncher"/>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavigation" Content="{local:Translate Key='Налаштування'}" Icon="Setting"
                                    ToolTipService.ToolTip="{local:Translate Key='Налаштування'}"/>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneCustomContent>
                <StackPanel x:Name="ProfilePane" Spacing="2" Margin="8,12,8,0">
                    <TextBlock Text="{local:Translate Key='Профілі'}" Margin="10,0,0,6" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <ListView x:Name="Profiles" Margin="4,0" MaxHeight="360" SelectionChanged="Select"
                              IsItemClickEnabled="True" ItemClick="OpenSidebarProfile">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Width="22" Height="22" Source="{Binding IconSource}"/>
                                    <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </NavigationView.PaneCustomContent>
            <NavigationView.PaneFooter>
                    <Button x:Name="AccountsButton" Width="40" Height="40" Padding="0"
                            Margin="8,3,0,3" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" CornerRadius="20"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="{local:Translate Key='Акаунти Minecraft'}" ToolTipService.ToolTip="{local:Translate Key='Акаунти Minecraft'}">
                        <PersonPicture x:Name="AccountAvatar" Width="32" Height="32"
                                       AutomationProperties.AccessibilityView="Raw"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuFlyoutItem Text="{local:Translate Key='Керувати акаунтами'}" Click="ManageAccounts">
                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Contact"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="{local:Translate Key='Увійти в Microsoft'}" Click="MicrosoftLogin"/>
                                <MenuFlyoutItem Text="{local:Translate Key='Додати офлайн-акаунт'}" Click="Login"/>
                                <MenuFlyoutItem Text="{local:Translate Key='Скін Minecraft'}" Click="ManageSkin"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
            </NavigationView.PaneFooter>
            <Grid x:Name="LibrarySurface">
                <ScrollViewer x:Name="LibraryPage">
                    <StackPanel>
                        <Grid Height="350">
                            <Image x:Name="Cover" Stretch="UniformToFill" Source="ms-appx:///Assets/Cover.png"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop x:Name="CoverClear" Offset=".38"/>
                                        <GradientStop x:Name="CoverFade" Offset=".76"/>
                                        <GradientStop x:Name="CoverSolid" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Padding="30,0,30,22" Spacing="11">
                                <TextBlock x:Name="Heading" Text="{local:Translate Key='Бібліотека'}" FontSize="42" FontWeight="Bold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PlayButton" Background="#112C2B" Foreground="White" Content="{local:Translate Key='▶  Грати'}" Click="Play" IsEnabled="False" Padding="24,8" CornerRadius="18"/>
                                    <Button Content="{local:Translate Key='Оновити'}" Click="Refresh"/>
                                    <DropDownButton x:Name="ProfileActions" Content="{local:Translate Key='Дії профілю'}" IsEnabled="False">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{local:Translate Key='Перейменувати'}" Click="RenameProfile"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Змінити іконку'}" Click="ChangeProfileIcon"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Java та пам’ять'}" Click="EditProfileLaunchSettings"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Групи профілю'}" Click="ProfileGroups"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Дублювати'}" Click="DuplicateProfile"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Експортувати .mrpack'}" Click="ExportProfile"/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Відкрити папку профілю'}" Click="OpenProfileFolder"/>
                                        <MenuFlyoutItem Text="{local:Translate Key='Створити ярлик'}" Click="CreateProfileShortcut"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="{local:Translate Key='Видалити профіль'}" Click="RemoveProfile"/>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Padding="30,0,30,32" Spacing="14">
                            <Border BorderBrush="#5B9390" BorderThickness="0,1,0,1" Padding="0,12">
                                <TextBlock x:Name="Metadata" Text="{local:Translate Key='Виберіть профіль або імпортуйте модпак.'}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Pivot x:Name="Details" SelectionChanged="DetailChanged">
                                <PivotItem x:Name="LogTab" Header="{local:Translate Key='Логи'}">
                                    <StackPanel Spacing="12">
                                        <ComboBox x:Name="LogPicker" Header="{local:Translate Key='Джерело логу'}" DisplayMemberPath="Label"
                                                  SelectionChanged="LogChanged" IsEnabled="False" MaxWidth="380"/>
                                        <TextBlock x:Name="GameLog" Text="{local:Translate Key='Виберіть профіль.'}" FontFamily="Consolas"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem Header="{local:Translate Key='Завантаження'}">
                                    <StackPanel x:Name="Jobs" Spacing="8"/>
                                </PivotItem>
                                <PivotItem x:Name="ContentTab" Header="{local:Translate Key='Контент'}">
                                    <StackPanel Spacing="8">
                                        <Button x:Name="AddModButton" Content="{local:Translate Key='+  Додати .jar'}" Click="AddMod" IsEnabled="False"/>
                                        <StackPanel x:Name="ContentRows" Spacing="8"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="WorldsTab" Header="{local:Translate Key='Світи'}">
                                    <StackPanel x:Name="WorldRows" Spacing="8"/>
                                </PivotItem>
                                <PivotItem x:Name="ScreenshotsTab" Header="{local:Translate Key='Скриншоти'}">
                                    <StackPanel Spacing="12">
                                        <Button x:Name="ExportShotsButton" Content="{local:Translate Key='Експортувати всі у ZIP'}"
                                                IsEnabled="False" Click="ExportScreenshots"/>
                                        <ComboBox x:Name="ScreenshotPicker" Header="{local:Translate Key='Скриншот'}" DisplayMemberPath="filename"
                                                  IsEnabled="False" SelectionChanged="ScreenshotChanged"/>
                                        <TextBlock x:Name="ScreenshotStatus" Text="{local:Translate Key='Виберіть профіль.'}" TextWrapping="Wrap"/>
                                        <Image x:Name="ScreenshotPreview" MaxHeight="440" Stretch="Uniform"
                                               HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="FilesTab" Header="{local:Translate Key='Файли'}">
                                    <StackPanel Spacing="8">
                                        <Button x:Name="ParentDirectoryButton" Content="{local:Translate Key='На рівень вище'}" Click="ParentDirectory" IsEnabled="False"/>
                                        <TextBlock x:Name="DirectoryLabel" Text="{local:Translate Key='Файли профілю'}" TextWrapping="Wrap"/>
                                        <ListView x:Name="FileList" MaxHeight="380" DisplayMemberPath="Label"
                                                  IsItemClickEnabled="True" SelectionMode="None" ItemClick="OpenFileEntry"/>
                                    </StackPanel>
                                </PivotItem>
                                <PivotItem x:Name="ServersTab" Header="{local:Translate Key='Сервери'}">
                                    <StackPanel Spacing="8">
                                        <Button x:Name="AddServerButton" Content="{local:Translate Key='Додати сервер'}" Click="AddServer" IsEnabled="False"/>
                                        <StackPanel x:Name="ServerRows" Spacing="10"/>
                                    </StackPanel>
                                </PivotItem>
                            </Pivot>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel Padding="30" Spacing="16" HorizontalAlignment="Left" MaxWidth="680">
                        <Button Content="{local:Translate Key='До бібліотеки'}" Click="CloseSettings"/>
                        <TextBlock Text="{local:Translate Key='Вигляд і мова'}" Style="{StaticResource TitleTextBlockStyle}"/>
                        <ComboBox x:Name="ThemeSetting" Header="{local:Translate Key='Тема'}" SelectionChanged="ChangeAppearance">
                            <ComboBoxItem Content="{local:Translate Key='Системна'}" Tag="system"/>
                            <ComboBoxItem Content="{local:Translate Key='Світла'}" Tag="light"/>
                            <ComboBoxItem Content="{local:Translate Key='Темна'}" Tag="dark"/>
                        </ComboBox>
                        <ComboBox x:Name="LanguageSetting" Header="{local:Translate Key='Мова'}" SelectionChanged="ChangeAppearance">
                            <ComboBoxItem Content="Українська" Tag="uk"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                        <TextBlock x:Name="AppearanceStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{local:Translate Key='Налаштування запуску'}" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBox x:Name="MemorySetting" Header="{local:Translate Key='Максимум пам’яті (МіБ)'}" InputScope="Number"/>
                        <ToggleSwitch x:Name="FullscreenSetting" Header="{local:Translate Key='На весь екран'}"
                                      OnContent="{local:Translate Key='Увімкнено'}" OffContent="{local:Translate Key='Вимкнено'}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="WidthSetting" Header="{local:Translate Key='Ширина (пкс)'}" InputScope="Number" MinWidth="140"/>
                            <TextBox x:Name="HeightSetting" Header="{local:Translate Key='Висота (пкс)'}" InputScope="Number" MinWidth="140"/>
                        </StackPanel>
                        <TextBox x:Name="ArgumentsSetting" Header="{local:Translate Key='Аргументи JVM · один на рядок'}" AcceptsReturn="True"
                                 FontFamily="Consolas" TextWrapping="Wrap" MinHeight="96"/>
                        <Button x:Name="SaveSettingsButton" Content="{local:Translate Key='Зберегти'}" Click="SaveSettings"/>
                        <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="{local:Translate Key='Інсталяції Java'}" Click="ManageJava"/>
                        <TextBlock x:Name="JavaStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="{local:Translate Key='Увімкнути посилання Gradient'}" Click="RegisterProjectLinks"/>
                        <Button x:Name="CheckUpdateButton" Content="{local:Translate Key='Перевірити оновлення'}" Click="CheckUpdate"/>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <HyperlinkButton x:Name="UpdateDownload" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="DiscoverPage" Visibility="Collapsed" Padding="24"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button AutomationProperties.Name="{local:Translate Key='До бібліотеки'}"
                                ToolTipService.ToolTip="{local:Translate Key='До бібліотеки'}" Click="CloseDiscover">
                            <SymbolIcon Symbol="Back"/>
                        </Button>
                        <TextBlock Text="{local:Translate Key='Каталог Modrinth'}" Style="{StaticResource TitleTextBlockStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Border HorizontalAlignment="Left" Padding="4" CornerRadius="24"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel x:Name="DiscoverCategories" Orientation="Horizontal" Spacing="2"
                                            AutomationProperties.Name="{local:Translate Key='Тип контенту'}">
                                    <StackPanel.Resources>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="12,6"/>
                                            <Setter Property="CornerRadius" Value="18"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <ToggleButton Content="{local:Translate Key='Збірки'}" Tag="modpack" IsChecked="True" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Моди'}" Tag="mod" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Пакети ресурсів'}" Tag="resourcepack" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Пакети даних'}" Tag="datapack" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Шейдери'}" Tag="shader" Click="DiscoverCategoryClick"/>
                                    <ToggleButton Content="{local:Translate Key='Сервери'}" Tag="server" Click="DiscoverCategoryClick"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="DiscoverQuery" PlaceholderText="{local:Translate Key='Знайти на Modrinth'}" QueryIcon="Find"
                                            QuerySubmitted="DiscoverSearch"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{local:Translate Key='Пошук'}" Click="DiscoverSearchClick"/>
                                <Button Content="{local:Translate Key='Відкрити посилання'}" Click="OpenLinkClick"/>
                            </StackPanel>
                        </Grid>
                        <Expander Header="{local:Translate Key='Фільтри та сортування'}" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="DiscoverSort" Header="{local:Translate Key='Сортувати'}" SelectedIndex="0">
                                    <ComboBoxItem Content="{local:Translate Key='Автоматично'}"/>
                                    <ComboBoxItem x:Name="DiscoverPopularity" Content="{local:Translate Key='За завантаженнями'}" Tag="downloads"/>
                                    <ComboBoxItem Content="{local:Translate Key='Найновіші'}" Tag="newest"/>
                                    <ComboBoxItem Content="{local:Translate Key='Нещодавно оновлені'}" Tag="updated"/>
                                </ComboBox>
                                <StackPanel x:Name="DiscoverPackFilters" Spacing="8">
                                    <TextBox x:Name="DiscoverGameVersion" Header="{local:Translate Key='Версія Minecraft'}" PlaceholderText="{local:Translate Key='Наприклад, 1.21.1'}"/>
                                    <ComboBox x:Name="DiscoverLoader" Header="{local:Translate Key='Завантажувач'}" SelectedIndex="0">
                                        <ComboBoxItem Content="{local:Translate Key='Усі'}"/>
                                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                        <ComboBoxItem Content="Forge" Tag="forge"/>
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                        <ComboBoxItem Content="Quilt" Tag="quilt"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="{local:Translate Key='Застосувати'}" Click="DiscoverSearchClick"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <ListView x:Name="DiscoverResults" Grid.Row="2" IsItemClickEnabled="True"
                              SelectionMode="None" ItemClick="SelectDiscoverResult">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                            <Grid Margin="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Width="44" Height="44" VerticalAlignment="Top">
                                    <Image Source="{Binding IconSource}" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding author}"/>
                                    <TextBlock Text="{Binding description}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DiscoverBack" Content="{local:Translate Key='Попередня сторінка'}" IsEnabled="False" Click="DiscoverPrevious"/>
                            <Button x:Name="DiscoverMore" Content="{local:Translate Key='Наступна сторінка'}" IsEnabled="False" Click="DiscoverNext"/>
                        </StackPanel>
                        <TextBlock x:Name="DiscoverStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
